# =============================================================================
# KaratePose-AI — .gitignore
# =============================================================================
# This file tells Git which files/folders to IGNORE (not track).
# Large binary files, secrets, and auto-generated outputs should never
# be committed to GitHub.
# =============================================================================

# --- Python Virtual Environment (1.5 GB — NEVER commit this) ---
.venv/
venv/
env/
myenv/

# --- AI Model Weights (too large for GitHub, re-downloadable) ---
*.task
*.pt
*.onnx
*.tflite

# --- Python Bytecode Cache ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# --- IDE / Editor Settings ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# --- Output Data (regenerated by running the pipeline) ---
output/
data/landmarks/

# --- Raw Experimental Videos (too large, keep on local drive) ---
data/raw/

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/

# --- OS Files ---
Thumbs.db
.DS_Store

# --- Distribution / Packaging ---
dist/
build/
*.egg-info/
